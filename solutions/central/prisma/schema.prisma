generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  //
  name          String?
  username      String?
  email         String    @unique
  password      String?
  image         String?
  emailVerified DateTime?
  //
  role          Role      @default(USER)
  profile       Profile?
  accounts      Account[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  userId            String  @unique @db.ObjectId
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  //
  type              String
  provider          String
  providerAccountId String
  //
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Profile {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  //
  userId        String    @unique @db.ObjectId
  user          User      @relation(fields: [userId], references: [id])
  //
  bio           String    @default("")
  level         String    @default("1")
  experience    String    @default("0")
  lastCheckIn   DateTime?
  //
  posts         Post[]
  plans         Plan[]
  activityNames String[]
  //
  followers     Follow[]  @relation(name: "following")
  following     Follow[]  @relation(name: "follower")
  //
  badgeIds      String[]  @db.ObjectId
  badges        Badge[]   @relation(fields: [badgeIds], references: [id])
}

model Post {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  //
  authorId String   @db.ObjectId
  author   Profile  @relation(fields: [authorId], references: [id])
  //
  title    String
  body     String
  tags     String[]
  public   Boolean
  postDate DateTime
  //
  planId   String?   @db.ObjectId
  plan     Plan?     @relation(fields: [planId], references: [id])
}

model Plan {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  //
  creatorId  String?    @db.ObjectId
  creator    Profile?   @relation(fields: [creatorId], references: [id])
  //
  name       String
  activities Activity[]
  //
  public     Boolean
  created    DateTime
  edited     DateTime?
  //
  Post       Post[]
}

model Follow {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  profileId   String  @db.ObjectId
  profile     Profile @relation(name: "follower", fields: [profileId], references: [id])
  //
  followingId String  @db.ObjectId
  following   Profile @relation(name: "following", fields: [followingId], references: [id])
}

model Level {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  level     String @unique
  threshold String
}

model Badge {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  profileIds String[]  @db.ObjectId
  profiles   Profile[] @relation(fields: [profileIds], references: [id])
}

enum Role {
  USER
  ADMIN
}

type Activity {
  name   String
  weight String?
  reps   String?
  time   String?
}
