{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "build": "tsup server.ts",
    "clean": "rm -rf dist",
    "dev": "pnpm run build --watch --onSuccess 'node dist/server.js'",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@fyp/jest-presets/node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@fyp/eslint-config": "workspace:^",
    "@fyp/jest-presets": "workspace:^",
    "@fyp/typescript-config": "workspace:^",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "jest": "^29.7.0",
    "tsup": "^8.0.1",
    "typescript": "^5"
  }
}
