{
  "extends": "@fyp/typescript-config/base.json",
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    // "strict": true,
    "esModuleInterop": true,
    // "skipLibCheck": true,
    "noImplicitAny": false,
    "outDir": "dist",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
