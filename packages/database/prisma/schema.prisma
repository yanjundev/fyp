// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  //
  name          String?
  username      String?
  email         String    @unique
  password      String?
  image         String?
  emailVerified DateTime?
  //
  role          Role      @default(USER)
  profile       Profile?
  accounts      Account[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  userId            String  @unique @db.ObjectId
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  //
  type              String
  provider          String
  providerAccountId String
  //
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Profile {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  //
  userId        String          @unique @db.ObjectId
  user          User            @relation(fields: [userId], references: [id])
  //
  bio           String          @default("")
  level         String          @default("1")
  experience    String          @default("0")
  lastCheckIn   DateTime?
  //
  posts         Post[]
  plans         Plan[]
  activityNames String[]
  //
  followers     Follow[]        @relation(name: "following")
  following     Follow[]        @relation(name: "follower")
  //
  badgeIds      String[]        @db.ObjectId
  badges        Badge[]         @relation(fields: [badgeIds], references: [id])
  //
  LikedPosts    LikedPosts[]
  LikedPlans    LikedPlans[]
  DislikedPosts DislikedPosts[]
  DislikedPlans DislikedPlans[]
  //
  SimilarPosts  SimilarPosts[]
  SimilarPlans  SimilarPlans[]
}

model Post {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  //
  authorId       String           @db.ObjectId
  author         Profile          @relation(fields: [authorId], references: [id])
  //
  title          String
  body           String
  tags           String[]
  public         Boolean
  postDate       DateTime
  //
  planId         String?          @db.ObjectId
  plan           Plan?            @relation(fields: [planId], references: [id])
  //
  popularPosts   PopularPosts[]
  discoveryPosts DiscoveryPosts[]
  likedPosts     LikedPosts[]
  dislikedPosts  DislikedPosts[]
}

model Plan {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  //
  creatorId     String?         @db.ObjectId
  creator       Profile?        @relation(fields: [creatorId], references: [id])
  //
  name          String
  description   String?
  activities    Activity[]
  tags          String[]
  //
  public        Boolean
  created       DateTime
  edited        DateTime?
  posts         Post[]
  //
  likedPlans    LikedPlans[]
  dislikedPlans DislikedPlans[]
}

model Follow {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  profileId   String  @db.ObjectId
  profile     Profile @relation(name: "follower", fields: [profileId], references: [id])
  //
  followingId String  @db.ObjectId
  following   Profile @relation(name: "following", fields: [followingId], references: [id])
}

model Level {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  level     String @unique
  threshold String
}

model Badge {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  profileIds String[]  @db.ObjectId
  profiles   Profile[] @relation(fields: [profileIds], references: [id])
}

enum Role {
  USER
  ADMIN
}

type Activity {
  name   String
  weight String?
  reps   String?
  time   String?
}

//
//  RECOMMENDATIONS
//

model DiscoveryPosts {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  //
  postId String   @db.ObjectId
  post   Post     @relation(fields: [postId], references: [id])
  //
  added  DateTime
}

model PopularPosts {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  //
  postId String   @db.ObjectId
  post   Post     @relation(fields: [postId], references: [id])
  //
  added  DateTime
}

model LikedPosts {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  postId    String  @db.ObjectId
  post      Post    @relation(fields: [postId], references: [id])
  //
  profileId String  @db.ObjectId
  profile   Profile @relation(fields: [profileId], references: [id])
}

model DislikedPosts {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  postId    String  @db.ObjectId
  post      Post    @relation(fields: [postId], references: [id])
  //
  profileId String  @db.ObjectId
  profile   Profile @relation(fields: [profileId], references: [id])
}

model LikedPlans {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  planId    String  @db.ObjectId
  plan      Plan    @relation(fields: [planId], references: [id])
  //
  profileId String  @db.ObjectId
  profile   Profile @relation(fields: [profileId], references: [id])
}

model DislikedPlans {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  //
  planId    String  @db.ObjectId
  plan      Plan    @relation(fields: [planId], references: [id])
  //
  profileId String  @db.ObjectId
  profile   Profile @relation(fields: [profileId], references: [id])
}

model SimilarPosts {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  //
  profileId   String       @unique @db.ObjectId
  profile     Profile      @relation(fields: [profileId], references: [id])
  //
  similarity  Similarity[]
  suggestions Suggestion[]
}

model SimilarPlans {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  //
  profileId   String       @unique @db.ObjectId
  profile     Profile      @relation(fields: [profileId], references: [id])
  //
  similarity  Similarity[]
  suggestions Suggestion[]
}

type Similarity {
  user       String @db.ObjectId
  similarity String
}

type Suggestion {
  item   String @db.ObjectId
  weight String
}
